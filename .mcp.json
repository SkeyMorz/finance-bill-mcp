{
  "mcpServers": {
    "finance-bill": {
      "command": "node",
      "args": ["./dist/server.js"],
      "env": {
        "FEISHU_WEBHOOK_URL": "your-webhook-url",
        "SMTP_HOST": "smtp.example.com",
        "SMTP_PORT": "587",
        "SMTP_USER": "your-email@example.com",
        "SMTP_PASS": "your-smtp-password",
        "SMTP_FROM": "your-email@example.com"
      }
    }
  }
}
